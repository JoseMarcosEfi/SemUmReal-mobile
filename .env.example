# Copy to .env.local (gitignored). Restart Expo after changing.

# API local via USB: adb reverse tcp:8080 tcp:8080
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080/semumreal

# Google Cloud Console > Credentials > OAuth client ID tipo WEB
# O mesmo ID deve estar em APP_GOOGLE_CLIENT_IDS no backend.
# O cliente Android (pacote + SHA-1) fica só no Google Cloud — não coloque o ID Android aqui.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=seu-id.apps.googleusercontent.com
