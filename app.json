{
  "expo": {
    "name": "semumreal",
    "slug": "semumreal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "semumreal",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jmarcos.semumreal"
    },
    "android": {
      "package": "com.jmarcos.semumreal",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1091053613120-g3l7ckm6uqbj21f5u91h0f2dt6156bpl"
        }
      ]
    ]
  }
}
